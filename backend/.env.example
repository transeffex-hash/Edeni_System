# Backend
APP_NAME=EdeniSystem API
ENV=dev

# Security
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# PII encryption (field-level encryption at rest)
# Generate strong random keys for production and store them in a secret manager.
PII_ENCRYPTION_KEY=change-me
PII_HMAC_KEY=change-me

# Firebase push notifications (FCM)
FIREBASE_SERVICE_ACCOUNT_PATH=

# Platform admin (simple admin panel for you)
PLATFORM_ADMIN_EMAIL=harerimana456@gmail.com
PLATFORM_ADMIN_PASSWORD=ChangeMe123!

# Database
DATABASE_URL=postgresql://[user]:[password]@[host]:[port]/[db]?sslmode=require

# Testing/staging DB — used when USE_CLONE_DB=true env var is set
DATABASE_URL_CLONE=postgresql://postgres:password@localhost:5432/edeni_test

# CORS
CORS_ORIGINS=http://localhost:3000
